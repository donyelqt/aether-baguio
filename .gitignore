# dependencies
node_modules/
.pnpm-store/

# builds
.next/
out/
dist/
*.tsbuildinfo

# python
__pycache__/
*.py[cod]
.venv/
venv/

# env / secrets — never commit
.env
.env.local
.env.*.local

# research artifacts (scratch files, not project sources)
gdalv.json
pyrel.json
sched.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# replays + run output (regenerable from the event log)
data/runs/
*.replay.jsonl

# agent working files (local plans, planner scratch, checkpoints)
/.kilo/

# the architecture scaffold plan — a local working document, not pushed
docs/architecture-scaffold.md

# source geo downloads — licensed, bulky, and regenerable from checksums.
# the .gitkeep stays tracked so the directory survives.
data/raw/*
!data/raw/.gitkeep

# OSM extraction scratch (source data is committed; tiles are not reproducible artifacts)
.osm-scratch/

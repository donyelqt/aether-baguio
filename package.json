{
  "name": "aether-baguio",
  "private": true,
  "version": "0.1.0",
  "description": "AETHER: Baguio — browser-native 3D multi-agent urban simulation",
  "packageManager": "pnpm@9.5.0-beta.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2"
  }
}
